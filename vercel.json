{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/services/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/services", "destination": "/one-way-taxi", "permanent": true },
    { "source": "/cities/chennai", "destination": "/drop-taxi-chennai", "permanent": true },
    { "source": "/cities/coimbatore", "destination": "/drop-taxi-coimbatore", "permanent": true },
    { "source": "/cities/madurai", "destination": "/drop-taxi-madurai", "permanent": true },
    { "source": "/cities/trichy", "destination": "/drop-taxi-trichy", "permanent": true },
    { "source": "/cities/salem", "destination": "/drop-taxi-salem", "permanent": true },
    { "source": "/cities/erode", "destination": "/drop-taxi-erode", "permanent": true },
    { "source": "/cities/vellore", "destination": "/drop-taxi-vellore", "permanent": true },
    { "source": "/cities/bangalore", "destination": "/drop-taxi-bangalore", "permanent": true },
    { "source": "/cities/pondicherry", "destination": "/drop-taxi-pondicherry", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com https://www.googletagmanager.com https://www.google-analytics.com https://www.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://images.ctfassets.net https://images.unsplash.com; connect-src 'self' https://photon.komoot.io https://vitals.vercel-insights.com https://vitals.vercel-analytics.com https://www.google-analytics.com https://www.clarity.ms; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(png|webp|jpg|jpeg|svg|ico|woff2)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
